{
  "$schema": "./agent-access-policy.schema.json",
  "schema_version": "agent_access_policy.v1",
  "policy_version": 1,
  "default_role": "monitor",
  "capabilities": {
    "github": {
      "repository": "dennisonbertram/harness-arena",
      "allowed_identity_kinds": ["fine_grained_pat", "github_app", "authenticated_user"],
      "required_read_permissions": ["metadata", "contents", "actions", "issues", "pull_requests"],
      "write_permissions_allowed": false
    },
    "vercel": {
      "required_team_role": "VIEWER",
      "required_project_role": "VIEWER",
      "project_ids": ["prj_f4ppu0xpO0LZeHOAH99RHotVbwyo", "prj_YcSCWVj8OBPQ9XmQVuCGz4AMV2WA"],
      "static_project_scoped_viewer_token_available": false,
      "decrypted_environment_values_allowed": false
    },
    "get_only_ops": {
      "credential": "OPS_READ_TOKEN",
      "methods": ["GET"],
      "write_methods": ["POST", "PUT", "PATCH", "DELETE"],
      "write_expected_status": 405,
      "separate_from": ["AUTH_SECRET", "AUTH_GITHUB_SECRET", "COMPETITION_ADMIN_TOKEN", "RUNNER_CALLBACK_SECRET", "OPS_READ_CURSOR_SECRET", "BLOB_READ_WRITE_TOKEN", "AI_GATEWAY_API_KEY", "OPENROUTER_API_KEY", "GITHUB_TOKEN", "VERCEL_TOKEN"],
      "targets": {
        "production": {
          "project_id": "prj_f4ppu0xpO0LZeHOAH99RHotVbwyo",
          "hosts": ["harness-arena-psi.vercel.app"],
          "https_required": true
        },
        "development": {
          "project_id": "prj_YcSCWVj8OBPQ9XmQVuCGz4AMV2WA",
          "hosts": ["harness-arena-development.vercel.app", "harness-arena-git-codex-dev-environme-19f8e1-dennisons-projects.vercel.app"],
          "https_required": true
        },
        "local": {
          "project_id": null,
          "hosts": ["127.0.0.1", "localhost", "[::1]"],
          "https_required": false
        }
      }
    },
    "blob": { "direct_credential_allowed": false, "read_via": "get_only_ops" },
    "sandbox": { "direct_credential_allowed": false, "read_via": "get_only_ops" },
    "ai_gateway": { "spend_credential_allowed": false, "read_via": "vercel_logs" },
    "secrets": { "allowed_standing_credentials": ["OPS_READ_TOKEN"], "other_static_values_allowed": false, "metadata_allowed": true, "value_handling": "protected_ephemeral_only", "file_mode": "0600" }
  },
  "roles": {
    "monitor": { "purpose": "Continuous read-only health and deployment observation", "capabilities": ["github", "vercel", "get_only_ops", "blob", "sandbox", "ai_gateway", "secrets"], "standing_credentials": ["OPS_READ_TOKEN"], "secret_value_access": "metadata_only" },
    "diagnostic": { "purpose": "Read-only incident diagnosis with protected ephemeral secret-value access only when separately authorized", "capabilities": ["github", "vercel", "get_only_ops", "blob", "sandbox", "ai_gateway", "secrets"], "standing_credentials": ["OPS_READ_TOKEN"], "secret_value_access": "protected_ephemeral_only" }
  },
  "environment_inventory": {
    "source_paths": ["app", "lib", "mcp/src", "scripts", "next.config.ts", "instrumentation.ts"],
    "exclude_directories": ["node_modules", ".next", "coverage", "fixtures", "tests"],
    "exclude_suffixes": [".test.", ".spec.", "scripts/tests/"],
    "approved_dynamic_access": [
      { "file": "next.config.ts", "accessor": "key", "bounded_by": "LOCAL_NEUTRALIZED_ENV_KEYS" },
      { "file": "app/api/ready/route.ts", "accessor": "key", "bounded_by": "LOCAL_NEUTRALIZED_ENV_KEYS" },
      { "file": "lib/sandbox.ts", "accessor": "name", "bounded_by": "requireEnv call sites" }
