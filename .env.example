AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Independent caller credential for GET-only /api/ops/v1 routes. Never reuse
# or expose BLOB_READ_WRITE_TOKEN. Use a random 32+ byte value.
OPS_READ_TOKEN=
# Required independent server-only HMAC key for opaque ops cursors. It must not
# equal OPS_READ_TOKEN. Rotate to invalidate all outstanding cursors.
OPS_READ_CURSOR_SECRET=
RUNNER_CALLBACK_SECRET=
CALLBACK_BASE=
# Required for Sandbox runs. Set this to the canonical, publicly reachable HTTPS
# origin of the isolated Development deployment; Vercel Sandbox must be able to
# reach it. Do not use a localhost, loopback, production, or live origin.
# GitHub OAuth (required to sign in and submit) — generate with `npx auth secret`
AUTH_SECRET=
# From a GitHub OAuth App (github.com/settings/developers) — callback URL is
# <your-origin>/api/auth/callback/github. Use separate apps for localhost and
# production; Vercel preview deploys can't share one callback URL and don't
# support sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# /competition — fixed model for the daily prompt contest (default zai/glm-5.2)
COMPETITION_MODEL=
# /competition — shared secret required to trigger the baseline run; keep private
COMPETITION_ADMIN_TOKEN=
